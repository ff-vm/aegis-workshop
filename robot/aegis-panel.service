# systemd user service: start the web control panel when the robot boots.
# Installed by `./run_on_robot.sh firefly panel-install`. The panel never moves
# the dog on its own; it waits for someone to press a button.
[Unit]
Description=Aegis web control panel (ff_sdk)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ff_app
# aegis-run reads target_ip from sdk_config.yaml and sets footed.
ExecStart=/bin/sh %h/ff_app/aegis-run panel.py
# The hotspot address may not exist yet at boot; keep retrying the bind.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
